# Add environment variable names here.
# Never put real secrets in this file.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Local AI organizing for this-computer-only use.
OLLAMA_ENDPOINT=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# Optional private AI organizing provider for Vercel / small-group testing.
# Keep real values only in local .env or Vercel Environment Variables.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_REQUIRE_ZDR=false
NVIDIA_API_KEY=
NVIDIA_MODEL=openai/gpt-oss-20b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
MINDFLOW_DAILY_AI_LIMIT=50
MINDFLOW_ALLOW_LOCAL_ORGANIZE=false
