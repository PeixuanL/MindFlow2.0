# Add environment variable names here.
# Never put real secrets in this file.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Optional private AI organizing provider for Vercel / small-group testing.
# Keep real values only in local .env or Vercel Environment Variables.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MINDFLOW_DAILY_AI_LIMIT=50
MINDFLOW_ALLOW_LOCAL_ORGANIZE=false
